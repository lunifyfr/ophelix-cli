{
  "name": "@ophelix/cli",
  "version": "0.1.0",
  "description": "L'outil en ligne de commande d'Ophelix : connexion, relais des webhooks vers son poste, scénarios du mode test, requêtes en direct.",
  "keywords": [
    "ophelix",
    "cli",
    "webhooks",
    "fse",
    "sesam-vitale"
  ],
  "homepage": "https://docs.ophelix.fr/guides/ligne-de-commande",
  "bugs": {
    "url": "https://github.com/lunifyfr/ophelix-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunifyfr/ophelix-cli.git"
  },
  "license": "MIT",
  "author": "Lunify SAS",
  "type": "module",
  "bin": {
    "ophelix": "./dist/ophelix.js"
  },
  "files": [
    "dist/ophelix.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "build": "bun scripts/build.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/unit",
    "smoke": "node dist/ophelix.js --version && ./dist/ophelix --version"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/bun": "^1.3.4",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
